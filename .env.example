# Copy this file to .env and change SECRET_KEY before deployment.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=true
SEED_DEMO=true

# Default local database uses SQLite. For MySQL, set a URL such as:
# DATABASE_URL=mysql+pymysql://foodlink_user:your-password@localhost:3306/foodlink
DATABASE_URL=sqlite:///foodlink.db
